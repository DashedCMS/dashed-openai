{
    "name": "dashed/dashed-openai",
    "description": "OpenAI provider for Dashed AI",
    "keywords": ["Dashed", "laravel", "dashed-openai", "openai"],
    "homepage": "https://github.com/Dashed-DEV/dashed-openai",
    "license": "MIT",
    "authors": [
        {
            "name": "Robin van Maasakker",
            "email": "robin@dashed.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "dashed/dashed-ai": "*",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Dashed\\DashedOpenai\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dashed\\DashedOpenai\\DashedOpenaiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
